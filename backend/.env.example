# Copia este archivo a `.env` (o `.env.development`, `.env.staging`, `.env.production`) y completa los valores.
# No subas archivos .env con valores reales. Las variables ya definidas en el proceso
# (Docker, plataforma de despliegue) tienen prioridad sobre los archivos.
#
# NODE_ENV decide qué tan estricta es la validación al arrancar:
#   development (por defecto)  valores por defecto permitidos para trabajar en local
#   staging | production       secretos y CORS obligatorios; si faltan o son valores de
#                              ejemplo, el backend NO arranca y lista lo que falta
NODE_ENV=development
PORT=4000

# --- Base de datos (obligatorias en staging/production) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urbify_db

# --- Sesiones (obligatoria en staging/production: mínimo 32 caracteres aleatorios) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS (obligatoria en staging/production) ---
# Orígenes permitidos separados por comas, sin ruta ni "*". En production deben ser https.
# En development, si se omite, se permiten http://localhost:5173 y http://localhost
CORS_ORIGIN=http://localhost:5173

# --- Correo (obligatoria EMAIL_FROM en staging/production) ---
RESEND_API_KEY=
EMAIL_FROM=Urbify <notificaciones@urbify.app>

# --- Límites, proxy y HTTPS ---
# Tamaño máximo del body JSON
BODY_LIMIT=100kb
# Cantidad de proxys de confianza delante de la API (Nginx, balanceador). 0 = ninguno.
TRUST_PROXY=0
# true = redirige HTTP a HTTPS y activa HSTS (requiere TRUST_PROXY>=1)
FORCE_HTTPS=false
