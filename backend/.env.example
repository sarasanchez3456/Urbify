# Backend local (XAMPP o MySQL instalado). Copia como backend/.env.
# No subas backend/.env al repositorio.
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urbify_db

# Requerido: usa un valor largo y aleatorio fuera de desarrollo.
JWT_SECRET=reemplaza_esto_por_un_secreto_largo_y_unico
JWT_EXPIRES_IN=7d

# Opcional: notificaciones por correo.
RESEND_API_KEY=
EMAIL_FROM=Urbify <notificaciones@tu-dominio.com>
