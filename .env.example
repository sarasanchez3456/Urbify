# Variables para `docker compose up` (copia este archivo a `.env` en la raíz).
# `.env` está en .gitignore: nunca lo subas con valores reales.
# No hay valores por defecto para los secretos: sin DB_PASSWORD y JWT_SECRET, compose no arranca.

# Contraseña de MySQL (obligatoria)
DB_PASSWORD=

# Secreto de los JWT (obligatorio; 32+ caracteres aleatorios)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# production (por defecto) valida y exige configuración segura; usa development en local
NODE_ENV=production

# Orígenes permitidos por CORS, separados por comas (https en producción)
CORS_ORIGIN=http://localhost

EMAIL_FROM=Urbify <notificaciones@urbify.app>
RESEND_API_KEY=

# BODY_LIMIT=100kb
# TRUST_PROXY=1
# FORCE_HTTPS=false
