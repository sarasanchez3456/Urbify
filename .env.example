# Variables para `docker compose up` (copia este archivo a `.env` en la raíz).
# `.env` está en .gitignore: nunca lo subas con valores reales.
# No hay valores por defecto para los secretos: sin DB_PASSWORD y JWT_SECRET, compose no arranca.

# Contraseña de MySQL (obligatoria)
DB_PASSWORD=

# Secreto de los JWT (obligatorio; 32+ caracteres aleatorios)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# production (por defecto) valida y exige configuración segura; usa development en local
NODE_ENV=production

# Orígenes permitidos por CORS, separados por comas (https en producción)
CORS_ORIGIN=http://localhost

EMAIL_FROM=Urbify <notificaciones@urbify.app>
RESEND_API_KEY=

# Correo gratis por Gmail: cuenta SOLO para Urbify, con verificación en dos pasos y una "contraseña de aplicación" de 16 letras.
# Si GMAIL_USER y GMAIL_APP_PASSWORD están definidos, se usan en lugar de Resend. Nunca subas valores reales.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# BODY_LIMIT=100kb
# TRUST_PROXY=1
# FORCE_HTTPS=false

# ── Presentación (ver docs/PRESENTACION.md) ──
# Antivirus que intercepta HTTPS (Norton): certificado raíz en base64 para que Docker confíe en él (sin desactivar verificación).
# EXTRA_CA_PEM_B64=
# Con un túnel todos los visitantes comparten IP: subir los límites SOLO para la demostración.
# RATE_LIMIT_GLOBAL=20000
# RATE_LIMIT_PUBLIC_PER_MINUTE=5000
# RATE_LIMIT_REGISTER_PER_HOUR=500
# RATE_LIMIT_LOGIN_IP=2000
# RATE_LIMIT_LOGIN_ACCOUNT_IP=50
# RATE_LIMIT_VERIFY_IP_PER_HOUR=2000
# RATE_LIMIT_SEND_CODE_IP_PER_HOUR=500
